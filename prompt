} else {
    fmt.Println("One or more deployments failed. Closing CTASK.")

    actions.Update_task_closure(
        session_token,
        task_slice[i],
        "unsuccessful",
        "OpenShift deployment automation was unsuccessful.",
    )

    actions.Change_task_status(
        session_token,
        task_slice[i],
        "3",
        "",
    )

    parentCRQ := actions.TaskParentMap[task_slice[i]]

    fmt.Println("Canceling parent Change Request:", parentCRQ)

    actions.Change_crq_status(
        session_token,
        parentCRQ,
        "4",
    )
}
