func GetServiceNowUser(token, userID string) {
    u := &url.URL{
        Scheme: "https",
        Host:   SERVICENOW_API_HOST,
        Path:   "/api/now/table/sys_user/" + userID,
    }

    q := u.Query()
    q.Set("sysparm_fields", "sys_id,user_name,email,name")
    u.RawQuery = q.Encode()

    req, err := http.NewRequest("GET", u.String(), nil)
    if err != nil {
        fmt.Println("Request error:", err)
        return
    }

    req.Header.Set("Authorization", "Bearer "+token)
    req.Header.Set("Accept", "application/json")

    client := &http.Client{Timeout: 15 * time.Second}
    res, err := client.Do(req)
    if err != nil {
        fmt.Println("API error:", err)
        return
    }
    defer res.Body.Close()

    if res.StatusCode != http.StatusOK {
        fmt.Println("User lookup failed:", res.StatusCode)
        return
    }

    var data struct {
        Result struct {
            UserName string `json:"user_name"`
            Email    string `json:"email"`
            Name     string `json:"name"`
        } `json:"result"`
    }

    if err := json.NewDecoder(res.Body).Decode(&data); err != nil {
        fmt.Println("JSON error:", err)
        return
    }

    fmt.Println("Requester Name:", data.Result.Name)
    fmt.Println("Requester Login ID:", data.Result.UserName)
    fmt.Println("Requester Email:", data.Result.Email)
}
