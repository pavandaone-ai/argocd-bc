
# Stage 1: Build the Go chatbot
FROM INTERNAL_GO_BUILDER_IMAGE AS builder

WORKDIR /build

# Use the approved internal Go dependency proxy
ENV GOPROXY="INTERNAL_GO_PROXY_URL"

COPY go.mod go.sum ./
RUN go mod download

COPY client/ ./client/
COPY config/ ./config/

RUN CGO_ENABLED=0 GOOS=linux \
    go build -o /build/chatbot ./client

# Stage 2: Runtime image
FROM INTERNAL_UBI_MINIMAL_IMAGE

WORKDIR /app

COPY --from=builder /build/chatbot /app/chatbot
COPY --from=builder /build/client/index.html /app/client/index.html
COPY --from=builder /build/config/clusters.yaml /app/config/clusters.yaml

# Support OpenShift arbitrary non-root UIDs
USER 0
RUN chgrp -R 0 /app && chmod -R g=u /app

EXPOSE 8080

USER 1001

CMD ["/app/chatbot"]
