func Change_crq_status(token string, crq string, status string) {

	u := &url.URL{
		Scheme: "https",
		Host:   SERVICENOW_API_HOST,
		Path:   "/api/now/table/change_request/" + crq,
	}

	requestBody := map[string]string{
		"state": status,
	}

	bodyBytes, err := json.Marshal(requestBody)
	if err != nil {
		panic(err)
	}

	request, err := http.NewRequest(
		"PUT",
		u.String(),
		bytes.NewBuffer(bodyBytes),
	)
	if err != nil {
		panic(err)
	}

	request.Header.Add("Content-Type", "application/json")
	request.Header.Add("Accept", "application/json")
	request.Header.Add("Authorization", "Bearer "+string(token))

	client := &http.Client{}

	response, err := client.Do(request)
	if err != nil {
		fmt.Println("Error:", err)
		return
	}

	defer response.Body.Close()

	if response.StatusCode < 300 {
		fmt.Println("Change Request status updated successfully:", response.StatusCode)
	} else {
		fmt.Println("Change Request status update FAILED:", response.StatusCode)
	}
}
